APP_NAME=Flapabay-Staging
APP_ENV=staging
APP_KEY=base64:GENERATE_NEW_KEY_HERE
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://api.staging.flapabay.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=flapabay_staging
DB_USERNAME=flapabay_staging_user
DB_PASSWORD=STRONG_DATABASE_PASSWORD_HERE
DB_ROOT_PASSWORD=STRONG_ROOT_PASSWORD_HERE

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=api.staging.flapabay.com

# Broadcasting & Queue
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

# Pusher Configuration (if using Pusher instead of Reverb)
PUSHER_APP_ID="YOUR_PUSHER_APP_ID"
PUSHER_APP_KEY="YOUR_PUSHER_APP_KEY"
PUSHER_APP_SECRET="YOUR_PUSHER_APP_SECRET"
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME="https"
PUSHER_APP_CLUSTER="YOUR_PUSHER_CLUSTER"

# Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX=flapabay_staging

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=STRONG_REDIS_PASSWORD_HERE
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=staging@flapabay.com
MAIL_PASSWORD=YOUR_MAIL_PASSWORD_HERE
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=staging@flapabay.com
MAIL_FROM_NAME="${APP_NAME}"

# AWS/Wasabi Configuration
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=flapabay-staging
AWS_ENDPOINT=https://s3.us-east-1.wasabisys.com

# Stripe Configuration (TEST KEYS)
STRIPE_SECRET=sk_test_YOUR_TEST_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE=pk_test_YOUR_TEST_STRIPE_PUBLISHABLE_KEY

# JWT Configuration
JWT_SECRET=GENERATE_STRONG_JWT_SECRET_HERE

# Reverb Configuration
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8080
REVERB_HOST="api.staging.flapabay.com"
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_APP_ID=flapabay-staging
REVERB_APP_KEY=GENERATE_REVERB_APP_KEY_HERE
REVERB_APP_SECRET=GENERATE_REVERB_APP_SECRET_HERE

# Google OAuth Configuration
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.staging.flapabay.com/api/v1/google/callback

# Facebook OAuth Configuration
FACEBOOK_CLIENT_ID=YOUR_FACEBOOK_CLIENT_ID
FACEBOOK_CLIENT_SECRET=YOUR_FACEBOOK_CLIENT_SECRET
FACEBOOK_REDIRECT_URL=https://api.staging.flapabay.com/api/v1/facebook/callback

# SMS Configuration (Infobip)
INFOBIP_FROM=YOUR_INFOBIP_FROM_NUMBER
INFOBIP_USERNAME=YOUR_INFOBIP_USERNAME
INFOBIP_PASSWORD=YOUR_INFOBIP_PASSWORD
INFOBIP_BASE_URL=YOUR_INFOBIP_BASE_URL
INFOBIP_API_KEY=YOUR_INFOBIP_API_KEY
INFOBIP_SENDER=Flapabay-Staging

# SMS Configuration (Twilio)
TWILIO_SID=YOUR_TWILIO_SID
TWILIO_TOKEN=YOUR_TWILIO_TOKEN
TWILIO_FROM=YOUR_TWILIO_FROM_NUMBER