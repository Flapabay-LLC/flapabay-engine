APP_NAME=Flapabay-Local
APP_ENV=local
APP_KEY=base64:QI9WiXvlKBdJMhUYlCxSPJd8YGpIXe26PGq9X7+wMdc=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Docker)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=flapabay_local
DB_USERNAME=flapabay_user
DB_PASSWORD=password
DB_ROOT_PASSWORD=rootpassword

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# Broadcasting & Queue
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX=flapabay_local

# Redis Configuration (Docker)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Mail Configuration (MailHog for testing)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=test@flapabay.local
MAIL_FROM_NAME="${APP_NAME}"

# File Storage (Local for testing)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe Configuration (TEST KEYS ONLY)
STRIPE_SECRET=sk_test_YOUR_TEST_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE=pk_test_YOUR_TEST_STRIPE_PUBLISHABLE_KEY

# JWT Configuration
JWT_SECRET=your-local-jwt-secret-key-here

# Reverb Configuration (Local)
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8080
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_ID=flapabay-local
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret

# OAuth Configuration (Test/Local)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/api/v1/google/callback

FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
FACEBOOK_REDIRECT_URL=http://localhost/api/v1/facebook/callback

# SMS Configuration (Test/Mock)
INFOBIP_FROM=+1234567890
INFOBIP_USERNAME=test@example.com
INFOBIP_PASSWORD=testpassword
INFOBIP_BASE_URL=test.api.infobip.com
INFOBIP_API_KEY=test-api-key
INFOBIP_SENDER=FlapabayTest

TWILIO_SID=test-twilio-sid
TWILIO_TOKEN=test-twilio-token
TWILIO_FROM=+1234567890

# Local Development Toggles
TELESCOPE_ENABLED=true
DEBUGBAR_ENABLED=true
HORIZON_ENABLED=true