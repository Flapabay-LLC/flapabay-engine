								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "If-Match",
								"value": "{{current_etag}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Updated Villa Title\",\n  \"price_per_night\": 349.99,\n  \"amenities\": [\"wifi\", \"pool\", \"parking\", \"gym\"]\n}"
						},
