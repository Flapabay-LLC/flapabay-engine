		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"host@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('auth_token', response.access_token);",
									"    console.log('Auth token saved:', response.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "Wizard Listings",
			"item": [
				{
					"name": "Create New Listing (Draft)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Beautiful Oceanview Villa\",\n  \"description\": \"Stunning 3-bedroom villa with panoramic ocean views\",\n  \"property_type_id\": 1,\n  \"category_id\": 2,\n  \"address\": \"123 Ocean Drive\",\n  \"city\": \"Miami Beach\",\n  \"state\": \"FL\",\n  \"country\": \"USA\",\n  \"latitude\": 25.7617,\n  \"longitude\": -80.1918,\n  \"price_per_night\": 299.99,\n  \"currency\": \"USD\",\n  \"num_of_bedrooms\": 3,\n  \"num_of_bathrooms\": 2,\n  \"maximum_guests\": 6,\n  \"amenities\": [\"wifi\", \"pool\", \"parking\"],\n  \"images\": [\"image1.jpg\", \"image2.jpg\"],\n  \"finalize\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/wizard-listings",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"wizard-listings"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('draft_id', response.draft_id);",
									"    const etag = pm.response.headers.get('ETag');",
									"    pm.environment.set('current_etag', etag);",
									"    console.log('Draft created with ID:', response.draft_id);",
									"    console.log('ETag saved:', etag);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Create New Listing (Finalized)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Complete Beachfront Condo\",\n  \"description\": \"Fully furnished 2-bedroom condo steps from the beach\",\n  \"property_type_id\": 2,\n  \"category_id\": 1,\n  \"address\": \"456 Beach Boulevard\",\n  \"city\": \"San Diego\",\n  \"state\": \"CA\",\n  \"country\": \"USA\",\n  \"latitude\": 32.7157,\n  \"longitude\": -117.1611,\n  \"price_per_night\": 199.99,\n  \"currency\": \"USD\",\n  \"num_of_bedrooms\": 2,\n  \"num_of_bathrooms\": 2,\n  \"maximum_guests\": 4,\n  \"amenities\": [\"wifi\", \"beach_access\", \"balcony\"],\n  \"images\": [\"condo1.jpg\", \"condo2.jpg\", \"condo3.jpg\"],\n  \"finalize\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/wizard-listings",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"wizard-listings"
							]
						}
					}
				},
