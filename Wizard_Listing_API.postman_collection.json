							"raw": "{{base_url}}/api/v1/wizard-listings/{{draft_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"wizard-listings",
								"{{draft_id}}"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const etag = pm.response.headers.get('ETag');",
									"    pm.environment.set('current_etag', etag);",
									"    console.log('Updated ETag:', etag);",
									"}"
								],
								"type": "text/javascript"
